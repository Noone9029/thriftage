{
  "name": "thriftage",
  "version": "0.1.0",
  "private": true,
  "description": "Thriftage marketplace monorepo",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @thriftage/mobile --filter @thriftage/admin --filter @thriftage/api dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "ci:migration-safety": "node tooling/ci/migration-safety.mjs",
    "config:validate:api": "pnpm --filter @thriftage/config build && node tooling/config/validate-environment.mjs api",
    "config:validate:mobile": "pnpm --filter @thriftage/config build && node tooling/config/validate-environment.mjs mobile",
    "ai:eval": "pnpm --filter @thriftage/api ai:eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:doctor": "pnpm --filter @thriftage/mobile exec expo-doctor",
    "load:test:read": "k6 run tooling/load/k6-beta-read.js",
    "load:test:write": "k6 run tooling/load/k6-beta-write.js",
    "security:audit": "pnpm audit --audit-level critical",
    "security:artifacts": "node tooling/security/artifact-secret-scan.mjs",
    "security:authorization:staging": "node tooling/security/staging-authorization-matrix.mjs",
    "security:secrets": "node tooling/security/secret-scan.mjs",
    "staging:smoke": "node tooling/deployment/smoke-staging.mjs",
    "storage:reconcile": "node tooling/storage/reconcile-media.mjs",
    "supabase:verify-security": "node tooling/supabase/verify-security.mjs",
    "db:generate": "pnpm --filter @thriftage/db generate",
    "db:format": "pnpm --filter @thriftage/db prisma:format",
    "db:migrate:deploy": "pnpm --filter @thriftage/db migrate:deploy",
    "db:seed:categories": "pnpm --filter @thriftage/db seed:categories",
    "db:seed:styles": "pnpm --filter @thriftage/db seed:styles",
    "db:validate": "pnpm --filter @thriftage/db prisma:validate",
    "test:db": "pnpm --filter @thriftage/db test:integration && pnpm --filter @thriftage/api test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@supabase/supabase-js": "2.112.2",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
