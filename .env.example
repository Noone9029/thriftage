# Local PostgreSQL connection used by Prisma tooling.
DATABASE_URL="postgresql://thriftage:thriftage@localhost:5432/thriftage?schema=public"
TEST_DATABASE_URL="postgresql://thriftage:thriftage@localhost:5432/thriftage_test?schema=public"

# API runtime configuration.
NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
LOG_FORMAT="pretty"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-your-project-key"
SUPABASE_SECRET_KEY="sb_secret_replace-with-a-backend-only-key"
TWILIO_ACCOUNT_SID="ACreplacewith32charactersxxxxxxxxxx"
TWILIO_API_KEY_SID="SKreplacewith32charactersxxxxxxxxxx"
TWILIO_API_KEY_SECRET="replace-with-a-restricted-api-key-secret"
TWILIO_VERIFY_SERVICE_SID="VAreplacewith32charactersxxxxxxxxxx"
PHONE_VERIFICATION_ATTEMPT_TTL_SECONDS="600"
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
PHONE_VERIFICATION_MAX_STARTS="5"
PHONE_VERIFICATION_START_WINDOW_SECONDS="3600"
PHONE_VERIFICATION_MAX_SENDS="5"
PHONE_VERIFICATION_MAX_CHECKS="5"
PROFILE_IMAGE_BUCKET="profile-images"

# Public client configuration. Never place secrets in public variables.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-your-project-key"
