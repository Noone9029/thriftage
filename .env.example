# Local PostgreSQL connection used by Prisma tooling.
DATABASE_URL="postgresql://thriftage:thriftage@localhost:5432/thriftage?schema=public"
TEST_DATABASE_URL="postgresql://thriftage:thriftage@localhost:5432/thriftage_test?schema=public"

# API runtime configuration.
NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
LOG_FORMAT="pretty"

# Public client configuration. Never place secrets in public variables.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
