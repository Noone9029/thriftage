{
  "name": "@thriftage/config",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./src/api-environment.ts",
      "default": "./dist/api-environment.js"
    },
    "./mobile": {
      "types": "./src/mobile-environment.ts",
      "default": "./dist/mobile-environment.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@thriftage/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
