  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_style_profiles_user_id_fkey")
  styles            UserStylePreference[]
  colors            UserColorPreference[]
  fits              UserFitPreference[]
  sizes             UserSizePreference[]

  @@index([quizStatus, updatedAt], map: "user_style_profiles_status_updated_idx")
  @@map("user_style_profiles")
}

