  contextSnapshot Json               @default("{}") @map("context_snapshot") @db.JsonB
  archivedAt      DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ai_stylist_conversations_user_id_fkey")
  messages        AiStylistMessage[]
