  @@index([conversationId, createdAt, id], map: "ai_stylist_messages_conversation_created_idx")
  @@map("ai_stylist_messages")
}

model AiGeneration {
  id                    String                @id @default(uuid()) @db.Uuid
  conversationId        String                @map("conversation_id") @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  clientRequestId       String                @map("client_request_id") @db.Uuid
  provider              AiProviderCode
  requestedModel        String                @map("requested_model") @db.VarChar(100)
  returnedModel         String?               @map("returned_model") @db.VarChar(100)
  promptVersion         String                @map("prompt_version") @db.VarChar(60)
  toolSchemaVersion     String                @map("tool_schema_version") @db.VarChar(60)
  reasoningEffort       String                @map("reasoning_effort") @db.VarChar(20)
  status                AiGenerationStatus    @default(PROCESSING)
  inputTokens           Int                   @default(0) @map("input_tokens")
  cachedInputTokens     Int                   @default(0) @map("cached_input_tokens")
  outputTokens          Int                   @default(0) @map("output_tokens")
  estimatedCostMicroUsd Int                   @default(0) @map("estimated_cost_micro_usd")
  latencyMs             Int?                  @map("latency_ms")
  toolCallCount         Int                   @default(0) @map("tool_call_count")
  failureCode           String?               @map("failure_code") @db.VarChar(60)
  intentCategory        String?               @map("intent_category") @db.VarChar(60)
  responsePayload       Json?                 @map("response_payload") @db.JsonB
  startedAt             DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  conversation          AiStylistConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ai_generations_conversation_id_fkey")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ai_generations_user_id_fkey")
  savedOutfits          SavedOutfit[]
  attributionEvents     AiAttributionEvent[]
  feedback              AiResponseFeedback[]

  @@unique([userId, clientRequestId], map: "ai_generations_user_request_key")
  @@index([conversationId, startedAt, id], map: "ai_generations_conversation_started_idx")
  @@index([userId, startedAt, status], map: "ai_generations_user_started_status_idx")
  @@index([status, startedAt], map: "ai_generations_status_started_idx")
  @@index([provider, requestedModel, startedAt], map: "ai_generations_provider_model_started_idx")
  @@map("ai_generations")
}

model SavedOutfit {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  title                String                 @db.VarChar(120)
  sourceConversationId String?                @map("source_conversation_id") @db.Uuid
  sourceGenerationId   String?                @map("source_generation_id") @db.Uuid
  sourceOutfitId       String                 @map("source_outfit_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
