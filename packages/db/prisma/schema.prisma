  personalWeight     Int      @default(45) @map("personal_weight")
  behaviorWeight     Int      @default(15) @map("behavior_weight")
  sellerWeight       Int      @default(8) @map("seller_weight")
  freshnessWeight    Int      @default(12) @map("freshness_weight")
  trustWeight        Int      @default(8) @map("trust_weight")
  engagementWeight   Int      @default(7) @map("engagement_weight")
  explorationWeight  Int      @default(5) @map("exploration_weight")
  maxPerSeller       Int      @default(2) @map("max_per_seller")
  maxPerStyle        Int      @default(4) @map("max_per_style")
