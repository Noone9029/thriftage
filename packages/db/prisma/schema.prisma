model User {
  id                          String                     @id @default(uuid()) @db.Uuid
  authProviderUserId          String                     @unique(map: "users_auth_provider_user_id_key") @map("auth_provider_user_id") @db.VarChar(255)
  email                       String?                    @unique(map: "users_email_key") @db.VarChar(320)
  phone                       String?                    @unique(map: "users_phone_key") @db.VarChar(32)
  fullName                    String                     @map("full_name") @db.VarChar(120)
  role                        UserRole                   @default(USER)
  accountStatus               AccountStatus              @default(ACTIVE) @map("account_status")
  emailVerified               Boolean                    @default(false) @map("email_verified")
  phoneVerified               Boolean                    @default(false) @map("phone_verified")
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                   DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  profile                     Profile?
  phoneVerificationAttempts   PhoneVerificationAttempt[]
  listings                    Listing[]                  @relation("ListingSeller")
  listingLikes                ListingLike[]
  savedListings               SavedListing[]
  following                   Follow[]                   @relation("Follower")
  followers                   Follow[]                   @relation("Followed")
  reportsCreated              ModerationReport[]         @relation("ReportReporter")
  reportsTargetingUser        ModerationReport[]         @relation("ReportTargetUser")
  reportsAssigned             ModerationReport[]         @relation("ReportAssignedAdmin")
  moderationAudits            ModerationAudit[]          @relation("ModerationActor")
  conversationsAsSeller       Conversation[]             @relation("ConversationSeller")
  conversationsAsBuyer        Conversation[]             @relation("ConversationBuyer")
  messagesSent                Message[]                  @relation("MessageSender")
  messageFlagsReviewed        MessageModerationFlag[]    @relation("MessageFlagReviewer")
  messageModerationAudits     MessageModerationAudit[]   @relation("MessageModerationActor")
  addresses                   Address[]
  ordersAsBuyer               Order[]                    @relation("OrderBuyer")
  ordersAsSeller              Order[]                    @relation("OrderSeller")
  orderCancellations          Order[]                    @relation("OrderCancelledBy")
  orderEvents                 OrderEvent[]               @relation("OrderEventActor")
  notifications               Notification[]             @relation("NotificationRecipient")
  notificationActors          Notification[]             @relation("NotificationActor")
  pushDevices                 PushDevice[]
  notificationOutbox          NotificationOutbox[]       @relation("OutboxRecipient")
  notificationOutboxActions   NotificationOutbox[]       @relation("OutboxActor")
  reviewsGiven                Review[]                   @relation("ReviewReviewer")
  reviewsReceived             Review[]                   @relation("ReviewReviewee")
  reviewReports               ReviewReport[]             @relation("ReviewReportReporter")
  reviewReportsAssigned       ReviewReport[]             @relation("ReviewReportAdmin")
  reviewModerationAudits      ReviewModerationAudit[]    @relation("ReviewModerationActor")
  blocksCreated               UserBlock[]                @relation("Blocker")
  blocksReceived              UserBlock[]                @relation("BlockedUser")
  policyAcceptances           PolicyAcceptance[]
  policiesPublished           PolicyVersion[]            @relation("PolicyPublisher")
  disputesOpened              Dispute[]                  @relation("DisputeOpener")
  disputesAgainst             Dispute[]                  @relation("DisputeCounterparty")
  disputesAssigned            Dispute[]                  @relation("DisputeAdmin")
  disputeEvidenceUploaded     DisputeEvidence[]          @relation("DisputeEvidenceUploader")
  disputeEvents               DisputeEvent[]             @relation("DisputeEventActor")
  sellerVerifications         SellerVerification[]       @relation("SellerVerificationUser")
  sellerVerificationsReviewed SellerVerification[]       @relation("SellerVerificationReviewer")
  restrictions                UserRestriction[]          @relation("RestrictedUser")
  restrictionsCreated         UserRestriction[]          @relation("RestrictionCreator")
  safetyActionsTaken          SafetyAction[]             @relation("SafetyActionActor")
  safetyActionsReceived       SafetyAction[]             @relation("SafetyActionTarget")
  trustAuditsPerformed        TrustAudit[]               @relation("TrustAuditActor")
  trustAuditsTargeting        TrustAudit[]               @relation("TrustAuditTarget")
  styleProfile                UserStyleProfile?
  recommendationFeedback      RecommendationFeedback[]
  recommendationEvents        RecommendationEvent[]
  personalizationAudits       PersonalizationAudit[]     @relation("PersonalizationAuditUser")
  personalizationAuditActions PersonalizationAudit[]     @relation("PersonalizationAuditActor")
  aiStylistConversations      AiStylistConversation[]
  aiStylistGenerations        AiGeneration[]
  savedOutfits                SavedOutfit[]
  aiAttributionEvents         AiAttributionEvent[]
  accountDeletionRequest      AccountDeletionRequest?
  betaFeedbackSubmitted       BetaFeedback[]             @relation("BetaFeedbackSubmitter")
  betaFeedbackReviewed        BetaFeedback[]             @relation("BetaFeedbackReviewer")
  aiResponseFeedback          AiResponseFeedback[]       @relation("AiFeedbackSubmitter")
  aiResponseFeedbackReviewed  AiResponseFeedback[]       @relation("AiFeedbackReviewer")

  @@index([accountStatus], map: "users_account_status_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model AccountDeletionRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @unique(map: "account_deletion_requests_user_id_key") @map("user_id") @db.Uuid
  authProviderUserId    String?               @map("auth_provider_user_id") @db.VarChar(255)
  status                AccountDeletionStatus @default(REQUESTED)
  attempts              Int                   @default(0)
  nextAttemptAt         DateTime              @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt              DateTime?             @map("locked_at") @db.Timestamptz(3)
  sessionRevokedAt      DateTime?             @map("session_revoked_at") @db.Timestamptz(3)
  mediaDeletedAt        DateTime?             @map("media_deleted_at") @db.Timestamptz(3)
  dataAnonymizedAt      DateTime?             @map("data_anonymized_at") @db.Timestamptz(3)
  authIdentityDeletedAt DateTime?             @map("auth_identity_deleted_at") @db.Timestamptz(3)
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz(3)
  lastErrorCode         String?               @map("last_error_code") @db.VarChar(64)
  requestedAt           DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "account_deletion_requests_user_id_fkey")

  @@index([status, nextAttemptAt, requestedAt], map: "account_deletion_requests_status_next_idx")
  @@index([status, lockedAt], map: "account_deletion_requests_status_locked_idx")
  @@map("account_deletion_requests")
}

model BetaFeedback {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  category    BetaFeedbackCategory
  description String                 @db.VarChar(2000)
  route       String?                @db.VarChar(200)
  appVersion  String                 @map("app_version") @db.VarChar(40)
  buildNumber String                 @map("build_number") @db.VarChar(40)
  platform    FeedbackClientPlatform
  status      FeedbackReviewStatus   @default(OPEN)
  reviewerId  String?                @map("reviewer_id") @db.Uuid
  resolution  String?                @db.VarChar(1000)
  reviewedAt  DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                   @relation("BetaFeedbackSubmitter", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "beta_feedback_user_id_fkey")
  reviewer    User?                  @relation("BetaFeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "beta_feedback_reviewer_id_fkey")

  @@index([status, createdAt, id], map: "beta_feedback_status_created_idx")
  @@index([userId, createdAt], map: "beta_feedback_user_created_idx")
  @@map("beta_feedback")
}

model AiResponseFeedback {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  generationId String                 @map("generation_id") @db.Uuid
  kind         AiResponseFeedbackKind
  reason       String?                @db.VarChar(1000)
  status       FeedbackReviewStatus
  reviewerId   String?                @map("reviewer_id") @db.Uuid
  resolution   String?                @db.VarChar(1000)
  reviewedAt   DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User                   @relation("AiFeedbackSubmitter", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ai_response_feedback_user_id_fkey")
  generation   AiGeneration           @relation(fields: [generationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ai_response_feedback_generation_id_fkey")
  reviewer     User?                  @relation("AiFeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "ai_response_feedback_reviewer_id_fkey")

  @@unique([userId, generationId], map: "ai_response_feedback_user_generation_key")
  @@index([status, createdAt, id], map: "ai_response_feedback_status_created_idx")
  @@index([generationId], map: "ai_response_feedback_generation_idx")
  @@map("ai_response_feedback")
}

model PhoneVerificationAttempt {
  id                     String                         @id @default(uuid()) @db.Uuid
  userId                 String                         @map("user_id") @db.Uuid
  phone                  String                         @db.VarChar(32)
  provider               PhoneVerificationProvider      @default(TWILIO_VERIFY)
  providerReference      String?                        @map("provider_reference") @db.VarChar(64)
  status                 PhoneVerificationAttemptStatus @default(PENDING)
  sendCount              Int                            @default(1) @map("send_count")
  verificationCheckCount Int                            @default(0) @map("verification_check_count")
  expiresAt              DateTime                       @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt      DateTime                       @map("resend_available_at") @db.Timestamptz(3)
  providerVerifiedAt     DateTime?                      @map("provider_verified_at") @db.Timestamptz(3)
  linkedAt               DateTime?                      @map("linked_at") @db.Timestamptz(3)
  cancelledAt            DateTime?                      @map("cancelled_at") @db.Timestamptz(3)
  failedAt               DateTime?                      @map("failed_at") @db.Timestamptz(3)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "phone_verification_attempts_user_id_fkey")

  @@index([userId, status, createdAt], map: "phone_verification_attempts_user_status_created_idx")
  @@index([userId, createdAt], map: "phone_verification_attempts_user_created_idx")
  @@index([phone, status], map: "phone_verification_attempts_phone_status_idx")
  @@index([status, expiresAt], map: "phone_verification_attempts_status_expires_idx")
  @@map("phone_verification_attempts")
}

model Profile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique(map: "profiles_user_id_key") @map("user_id") @db.Uuid
  username            String   @unique(map: "profiles_username_key") @db.VarChar(30)
  profileImageUrl     String?  @map("profile_image_url") @db.VarChar(2048)
  profileImageKey     String?  @map("profile_image_key") @db.VarChar(255)
  bio                 String?  @db.VarChar(500)
  university          String?  @db.VarChar(160)
  completedSalesCount Int      @default(0) @map("completed_sales_count")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "profiles_user_id_fkey")

  @@index([createdAt], map: "profiles_created_at_idx")
  @@map("profiles")
}

model Category {
  id               String            @id @default(uuid()) @db.Uuid
  parentId         String?           @map("parent_id") @db.Uuid
  slug             String            @unique(map: "categories_slug_key") @db.VarChar(60)
  name             String            @db.VarChar(80)
  description      String?           @db.VarChar(240)
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "categories_parent_id_fkey")
  children         Category[]        @relation("CategoryTree")
  listings         Listing[]
  moderationAudits ModerationAudit[]

  @@index([parentId, isActive, sortOrder], map: "categories_parent_active_sort_idx")
  @@index([isActive, sortOrder], map: "categories_active_sort_idx")
  @@map("categories")
}

model Listing {
  id                     String                   @id @default(uuid()) @db.Uuid
  sellerId               String                   @map("seller_id") @db.Uuid
  categoryId             String                   @map("category_id") @db.Uuid
  title                  String                   @db.VarChar(120)
  description            String                   @db.VarChar(2000)
  priceMinor             Int                      @map("price_minor")
  currency               CurrencyCode             @default(PKR)
  condition              ListingCondition
  size                   String                   @db.VarChar(50)
  brand                  String?                  @db.VarChar(80)
  color                  String?                  @db.VarChar(50)
  colorFamily            ColorFamily?             @map("color_family")
  fitType                FitType?                 @map("fit_type")
  garmentRole            GarmentRole?             @map("garment_role")
  sizeSystem             SizeSystem?              @map("size_system")
  sizeCompatibilityKey   String?                  @map("size_compatibility_key") @db.VarChar(40)
  status                 ListingStatus            @default(DRAFT)
  rejectionReason        String?                  @map("rejection_reason") @db.VarChar(500)
  submittedAt            DateTime?                @map("submitted_at") @db.Timestamptz(3)
  moderatedAt            DateTime?                @map("moderated_at") @db.Timestamptz(3)
  activatedAt            DateTime?                @map("activated_at") @db.Timestamptz(3)
  archivedAt             DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  seller                 User                     @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "listings_seller_id_fkey")
  category               Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "listings_category_id_fkey")
  images                 ListingImage[]
  likes                  ListingLike[]
  saves                  SavedListing[]
  reports                ModerationReport[]
  moderationAudits       ModerationAudit[]
  conversations          Conversation[]
  orders                 Order[]                  @relation("OrderListing")
  reservedOrderId        String?                  @unique(map: "listings_reserved_order_id_key") @map("reserved_order_id") @db.Uuid
  reservedByOrder        Order?                   @relation("CurrentListingReservation", fields: [reservedOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "listings_reserved_order_id_fkey")
  notifications          Notification[]
  notificationOutbox     NotificationOutbox[]
  styles                 ListingStyle[]
