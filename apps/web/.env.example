# Server-only. Use a pooled TLS PostgreSQL URL in deployed environments.
# With the current Supabase pooler and node-postgres, add uselibpqcompat=true
# beside sslmode=require. Never disable TLS.
DATABASE_URL=postgresql://postgres:password@localhost:5432/thriftage?schema=public

# At least 32 random characters. Used to pseudonymize form-abuse fingerprints.
MARKETING_FORM_HASH_SECRET=replace-with-at-least-32-random-characters

# Canonical origin. Keep the Vercel preview URL until a domain is approved.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional approved destinations. Missing values render as unavailable, not invented links.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_COMMUNITY_GUIDELINES_URL=
NEXT_PUBLIC_SUPPORT_URL=
