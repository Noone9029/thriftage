# Public build-time values. These are bundled into the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-project-key
NEXT_PUBLIC_DEPLOYMENT_ENV=local
NEXT_PUBLIC_RELEASE_VERSION=dev
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SUPPORT_URL=https://support.example.com
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://legal.example.com/privacy

# Server-only runtime/build values. Never prefix secrets with NEXT_PUBLIC_.
DEPLOYMENT_ENV=local
RELEASE_VERSION=dev
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
