NODE_ENV="production"
DEPLOYMENT_ENV="production"
RELEASE_VERSION="replace-with-production-git-sha"
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGINS="https://admin.example.com"
LOG_FORMAT="json"
DATABASE_URL="postgresql://thriftage_api:replace-with-secret@production-pooler.example.com:6543/postgres?sslmode=verify-full"
DATABASE_POOL_MAX="10"
SUPABASE_URL="https://production-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-production-key"
SUPABASE_SECRET_KEY="sb_secret_replace-with-production-secret"
TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_API_KEY_SID="SK00000000000000000000000000000000"
TWILIO_API_KEY_SECRET="replace-with-production-restricted-key-secret"
TWILIO_VERIFY_SERVICE_SID="VA00000000000000000000000000000000"
OPENAI_API_KEY="replace-with-production-project-key"
SENTRY_DSN="https://public-key@organization.ingest.sentry.io/project-id"
SENTRY_TRACES_SAMPLE_RATE="0.05"
SUPPORT_URL="https://support.example.com"
PRIVACY_POLICY_URL="https://legal.example.com/privacy"
TERMS_OF_USE_URL="https://legal.example.com/terms"
COMMUNITY_GUIDELINES_URL="https://legal.example.com/community"
ACCOUNT_DELETION_URL="https://privacy.example.com/delete-account"
REGISTRATION_ENABLED="false"
PHONE_AUTH_ENABLED="true"
SELLER_VERIFICATION_ENABLED="false"
ACCOUNT_DELETION_ENABLED="true"
ACCOUNT_DELETION_BATCH_SIZE="10"
ACCOUNT_DELETION_MAX_ATTEMPTS="10"
ACCOUNT_DELETION_POLL_INTERVAL_MS="5000"
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS="600"
ACCOUNT_DELETION_STALE_LOCK_SECONDS="300"
AI_STYLIST_ENABLED="false"
# Monetized Lahore beta gates. All money movement is fail-closed.
COD_ENABLED="false"
LOCAL_COURIER_ENABLED="false"
LOCAL_COURIER_SERVICE_CITIES="Lahore"
LOCAL_COURIER_SERVICE_COUNTRY_CODE="PK"
LAHORE_DELIVERY_FEE_MINOR="0"
LAHORE_DELIVERY_RATE_VERSION="lahore-flat-v1"
PAYFAST_ENABLED="false"
PAYFAST_LIVE_ENABLED="false"
PAYMENT_EXPIRY_MINUTES="15"
PAYOUTS_ENABLED="false"
MARKETPLACE_COMMISSION_BPS="1000"
WITHHOLDING_BPS="0"
WITHHOLDING_RULE_VERSION="withholding-unapproved-v1"
# Required only after provider/legal/courier approval:
# COMMERCIAL_APPROVAL_REFERENCE="counsel-and-accountant-reference"
# PAYFAST_MARKETPLACE_APPROVAL_REFERENCE="payfast-written-marketplace-approval"
# COURIER_AGREEMENT_REFERENCE="lahore-courier-agreement-reference"
# PAYFAST_CHECKOUT_URL="https://provider-issued-hosted-checkout.example"
# PAYFAST_STATUS_URL="https://provider-issued-status-api.example"
# PAYFAST_MERCHANT_ID="provider-issued-merchant-id"
# PAYFAST_SIGNING_SECRET="provider-issued-server-only-secret"
# PAYOUT_ENCRYPTION_KEY="base64url-encoded-32-byte-key"

AI_STYLIST_MODEL="gpt-5.6-terra"
AI_STYLIST_REASONING_EFFORT="medium"
AI_STYLIST_DAILY_BUDGET_MICRO_USD="250000"
EXPO_PUSH_ENABLED="false"
REALTIME_BROADCAST_ENABLED="true"
PROFILE_IMAGE_BUCKET="profile-images"
LISTING_IMAGE_BUCKET="listing-images"
DISPUTE_EVIDENCE_BUCKET="dispute-evidence"
