NODE_ENV="development"
DEPLOYMENT_ENV="local"
RELEASE_VERSION="development"
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
LOG_FORMAT="pretty"
REGISTRATION_ENABLED="true"
PHONE_AUTH_ENABLED="true"
SELLER_VERIFICATION_ENABLED="true"
ACCOUNT_DELETION_ENABLED="false"
ACCOUNT_DELETION_BATCH_SIZE="10"
ACCOUNT_DELETION_MAX_ATTEMPTS="10"
ACCOUNT_DELETION_POLL_INTERVAL_MS="5000"
ACCOUNT_DELETION_REAUTH_MAX_AGE_SECONDS="600"
ACCOUNT_DELETION_STALE_LOCK_SECONDS="300"
AI_STYLIST_ENABLED="false"
AI_STYLIST_MODEL="gpt-5.6-terra"
AI_STYLIST_REASONING_EFFORT="medium"
AI_STYLIST_MAX_OUTPUT_TOKENS="1800"
AI_STYLIST_MAX_TOOL_CALLS="6"
AI_STYLIST_TIMEOUT_MS="20000"
AI_STYLIST_DAILY_USER_LIMIT="20"
AI_STYLIST_SESSION_TURN_LIMIT="40"
AI_STYLIST_MAX_OUTFIT_OPTIONS="3"
AI_STYLIST_MAX_REQUESTS_PER_MINUTE="4"
AI_STYLIST_MAX_CONCURRENT_GENERATIONS="50"
AI_STYLIST_MAX_INPUT_CHARACTERS="2000"
# AI_STYLIST_DAILY_BUDGET_MICRO_USD="250000"
AI_STYLIST_INPUT_COST_MICRO_USD_PER_MILLION="2000000"
AI_STYLIST_CACHED_INPUT_COST_MICRO_USD_PER_MILLION="200000"
AI_STYLIST_OUTPUT_COST_MICRO_USD_PER_MILLION="12000000"
# OPENAI_API_KEY="replace-with-a-backend-only-project-key"
# Optional live eval only; ordinary development and CI must leave this disabled.
# AI_STYLIST_LIVE_EVAL_ENABLED="true"
# AI_STYLIST_EVAL_MODELS="gpt-5.6-terra"
# AI_STYLIST_EVAL_REASONING_EFFORTS="medium"
LISTING_IMAGE_BUCKET="listing-images"
LISTING_IMAGE_SIGNED_URL_TTL_SECONDS="900"
DISPUTE_EVIDENCE_BUCKET="dispute-evidence"
DISPUTE_EVIDENCE_SIGNED_URL_TTL_SECONDS="600"
# DISPUTE_EVIDENCE_RETENTION_DAYS="365" # Requires approved legal/business retention policy.
DISPUTE_WINDOW_HOURS="336"
DISPUTE_SHIPPED_MIN_AGE_HOURS="72"
SELLER_VERIFICATION_MIN_COMPLETED_SALES="0"
SELLER_VERIFICATION_REAPPLY_DAYS="30"
# SUPPORT_URL="https://support.example.com" # Client must provide official support/safety URL.
# PRIVACY_POLICY_URL="https://legal.example.com/privacy"
# TERMS_OF_USE_URL="https://legal.example.com/terms"
# COMMUNITY_GUIDELINES_URL="https://legal.example.com/community"
# ACCOUNT_DELETION_URL="https://privacy.example.com/delete-account"
# SENTRY_DSN="https://public-key@organization.ingest.sentry.io/project-id"
SENTRY_TRACES_SAMPLE_RATE="0"
CONVERSATION_MAX_STARTS_PER_DAY="25"
MESSAGE_MAX_SENDS_PER_MINUTE="20"
MESSAGE_MAX_BLOCKED_PER_HOUR="10"
OUTBOX_BATCH_SIZE="25"
OUTBOX_MAX_ATTEMPTS="10"
OUTBOX_POLL_INTERVAL_MS="1000"
PUSH_RECEIPT_DELAY_SECONDS="900"
REALTIME_BROADCAST_ENABLED="false"
EXPO_PUSH_ENABLED="false"
# EXPO_PUSH_ACCESS_TOKEN="replace-with-server-only-expo-access-token"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-your-project-key"
SUPABASE_SECRET_KEY="sb_secret_replace-with-a-backend-only-key"
TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_API_KEY_SID="SK00000000000000000000000000000000"
TWILIO_API_KEY_SECRET="replace-with-a-restricted-api-key-secret"
TWILIO_VERIFY_SERVICE_SID="VA00000000000000000000000000000000"
PHONE_VERIFICATION_ATTEMPT_TTL_SECONDS="600"
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
PHONE_VERIFICATION_MAX_STARTS="5"
PHONE_VERIFICATION_START_WINDOW_SECONDS="3600"
PHONE_VERIFICATION_MAX_SENDS="5"
PHONE_VERIFICATION_MAX_CHECKS="5"
PROFILE_IMAGE_BUCKET="profile-images"
